    {
      "id": "C",
      "title": "3. Bấm giờ từng bước đổi pin",
      "note": "Bấm Bắt đầu đúng lúc dừng xe trước tủ (bước 0). Xong mỗi bước thì bấm ghi mốc. Lần đầu bị lỗi phải làm lại thì thêm lần thử mới. Ghi thật kỹ bước 2 → 3 (đút pin cũ vào) và bước 5 → 6 (rút pin đầy ra): đây là chỗ tủ không có cửa có thể nhanh hơn tủ có cửa khóa.",
      "items": [
        {
          "kind": "table",
          "id": "C1",
          "title": "Bấm giờ các bước",
          "rowLabel": "Lần thử",
          "required": true,
          "minRows": 1,
          "note": "Bước 0: dừng xe trước tủ, bấm Bắt đầu. Bước 1: bắt đầu mở ứng dụng hoặc quét mã trên tủ. Bước 2: tủ chỉ ra ô trống để bỏ pin cũ vào. Bước 3: đút pin cũ vào ô xong, chốt giữ đã khóa. Bước 4: tủ hoặc ứng dụng báo đã nhận pin cũ. Bước 5: chốt ở ô có pin đầy tự nhả. Bước 6: rút pin đầy ra xong. Bước 7: ứng dụng hoặc màn hình tủ báo đã đổi xong. Bước 8: lắp pin vào xe, xe nhận pin, bắt đầu chạy đi.",
          "stopwatch": {
            "columns": ["t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8"],
            "cues": {
              "t7": { "text": "Chụp màn hình kết quả, ghi phần trăm pin mới", "field": "D-02" },
              "t8": { "text": "Xem phần trăm pin trên đồng hồ xe", "field": "D-03" }
            }
          },
          "columns": [
            { "id": "result", "label": "Kết quả lần thử", "type": "singleChoice", "options": [
