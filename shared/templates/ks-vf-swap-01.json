        { "id": "C-03", "label": "Đút pin cũ vào (bước 2 → 3)", "type": "computed", "unit": "giây", "decimals": 0, "formula": "avg(C1, {@t3} - {@t2}, {@result} == \"ok\")" },
        { "id": "C-04", "label": "Tủ xử lý pin cũ đến lúc nhả pin đầy (bước 4 → 5)", "type": "computed", "unit": "giây", "decimals": 0, "formula": "avg(C1, {@t5} - {@t4}, {@result} == \"ok\")" },
        { "id": "C-05", "label": "Rút pin đầy ra (bước 5 → 6)", "type": "computed", "unit": "giây", "decimals": 0, "formula": "avg(C1, {@t6} - {@t5}, {@result} == \"ok\")" },
