    {
      "id": "B",
      "title": "2. Số pin còn sẵn: ứng dụng báo và thực tế",
      "note": "Mục đích: xem ứng dụng báo số pin có đúng không và có bị chậm không.",
      "items": [
        { "id": "B-01", "label": "Trước khi đi, ứng dụng báo trạm còn bao nhiêu pin?", "type": "integer", "required": true, "min": 0, "unit": "pin",
          "parts": [ { "id": "at", "label": "Xem lúc", "type": "time" } ], "photoRef": "B-06" },
        { "id": "B-02", "label": "Khi đến nơi, thực tế trạm còn bao nhiêu pin?", "type": "integer", "required": true, "min": 0, "unit": "pin",
